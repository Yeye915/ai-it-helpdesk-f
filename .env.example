# Copy to .env.local and supply your own Atlas URI when using Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/it_helpdesk
MONGODB_DB=it_helpdesk
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional full endpoint; when set, overrides OLLAMA_BASE_URL for every AI API.
# OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=120000
OLLAMA_MAX_CONCURRENT=1
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=1024
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TIMEOUT_MS=10000
# Seed credentials: fill privately in .env.local; do not commit real values.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# DEMO_USER_EMAIL=
# DEMO_USER_PASSWORD=
